---
import type { Link } from '@layouts/MainLayout.astro';
import { isCurrentPage } from '@/utils/isCurrentPage';
type Props = {
  links: Link[];
};
const links = Astro.props.links;
const isCurrent = (href: string) => isCurrentPage(Astro.url.pathname, href);
const isHome = Astro.url.pathname === '/';
---

<div class='md:hidden flex justify-end w-full'>
  <div class='gap-2 flex justify-between items-center w-full'>
    <a
      href={isHome ? '#' : '/'}
      class='font-bold bg-zinc-700 tracking-wide rounded-full size-10 text-center place-content-center active:bg-zinc-600 transition-colors'>
      DP
    </a>
    <button popovertarget='mypopover' aria-label='Open menu' aria-expanded='false' aria-controls='mypopover'>
      <svg
        width='1.5rem'
        height='1.5rem'
        class='stroke-zinc-200 scale-x-[-1] active:scale-x-[-1.05] active:stroke-primary transition-colors'
        viewBox='0 0 24 24'
        fill='none'
        xmlns='http://www.w3.org/2000/svg'
        aria-hidden='true'>
        <path d='M4 6H20M4 12H14M4 18H9' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'></path>
      </svg>
    </button>
  </div>
  <div
    transition:name='menu'
    id='mypopover'
    popover
    role='dialog'
    aria-label='Site navigation'
    class='m-0 w-full bg-transparent p-4 motion-translate-x-in-100 -motion-translate-y-in-75 motion-duration-300'>
    <div class='flex w-full justify-end'>
      <div class='w-full bg-zinc-700 rounded-2xl p-4 relative'>
        <button
          popovertarget='mypopover'
          class='font-mono text-current ~text-2xl/4xl font-bold absolute right-4'
          aria-label='Close menu'>
          <svg
            width='1rem'
            height='1rem'
            class='stroke-zinc-200'
            viewBox='-0.5 0 25 25'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            aria-hidden='true'>
            <path d='M3 21.32L21 3.32001' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'></path>
            <path d='M3 3.32001L21 21.32' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'></path>
          </svg>
        </button>
        <nav aria-label='Main navigation'>
          <ul class='flex flex-col text-zinc-200 gap-4 py-2' role='menubar'>
            {
              links.map((link) => (
                <li class='py-1' role='none'>
                  <a
                    data-astro-prefetch
                    href={isCurrent(link.href) ? '#' : link.href}
                    class='hover:text-primary transition-colors tracking-wider p-1 outline-primary duration-300 border-b border-b-transparent hover:border-b-primary capitalize'
                    class:list={[isCurrent(link.href) ? 'text-primary' : '']}
                    role='menuitem'
                    aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                  <div class='border-b-[0.5px] border-zinc-600 w-full pt-1' aria-hidden='true' />
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>
<style>
  :root {
    --popover-animation-duration: 0.3s;
  }
  [popover]:popover-open {
    opacity: 1;
  }
  [popover] {
    /* Final state of the exit animation */
    opacity: 0;
    transition:
      opacity var(--popover-animation-duration) ease-in-out,
      overlay var(--popover-animation-duration) allow-discrete,
      display var(--popover-animation-duration) allow-discrete;
  }
  @starting-style {
    [popover]:popover-open {
      opacity: 0;
    }
  }

  [popover]::backdrop {
    backdrop-filter: blur(2px);
  }
</style>
