---
type Props = {
  class?: string;
};
const { class: className } = Astro.props;
---

<div
    class:list={[className]}
  class={`space-y-4
  prose-h1:~text-4xl/6xl
  prose-h2:~text-3xl/4xl
  prose-h3:~text-2xl/3xl
  prose-h4:~text-xl/2xl
  prose-h5:~text-lg/xl
  prose-h6:~text-base/lg
  prose-p:text-base/lg
  prose-p:max-w-[60em]
  prose-li:first-letter:capitalize
  prose-li:list-disc prose-li:ml-5 prose-li:max-w-[30em]
  prose-hr:opacity-30 prose-hr:border-[1px] prose-hr:rounded-full
  prose-time:text-2xl 
  prose-b:font-bold
  prose-pre:rounded-lg
  prose-pre:p-4
  prose-a:text-blue-400
  prose-a:underline
  prose-a:underline-offset-4
  overflow-auto
  font-afacad
  scroll-bar
  `}>
  <slot />
</div>
