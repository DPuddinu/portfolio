---
import { SEO } from 'astro-seo';
import { isCurrentPage } from '@/utils/isCurrentPage';
import Menu from '@components/Menu.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import Analytics from '@vercel/analytics/astro';
import { calculateExperienceYears } from '@/utils/getAgeAndExperience';

type Props = {
  title: string;
  description?: string;
  image?: string;
  type?: string;
};
const experienceYears = calculateExperienceYears(new Date('2019-07-01'));
const defaultDescription = `Senior Frontend Developer with over ${experienceYears} years of experience, specializing in Angular, React, and NextJS`;
const { title, description = defaultDescription, image = '/og-image.png', type = 'website' } = Astro.props;

export type Link = {
  href: string;
  label: string;
  title: string;
};

const links: Link[] = [
  {
    href: '/',
    label: 'Home',
    title: 'Home'
  },
  {
    href: '/about',
    label: 'About',
    title: 'About me'
  },
  {
    href: '/blog',
    label: 'Blog',
    title: 'My blog'
  },
  {
    href: '/til',
    label: 'TIL',
    title: 'Today I Learnt'
  }
];

const isCurrent = (href: string) => isCurrentPage(Astro.url.pathname, href);
---

<html lang='en' class='min-h-dvh scroll-bar'>
  <head>
    <link rel='sitemap' href='/sitemap-index.xml' />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title,
          type,
          image
        }
      }}
      twitter={{
        creator: '@dpdev92'
      }}
      extend={{
        meta: [
          { name: 'viewport', content: 'width=device-width, initial-scale=1.0' },
          { name: 'generator', content: Astro.generator }
        ],
        link: [
          { rel: 'icon', type: 'image/x-icon', href: '/favicon.ico', sizes: 'any' },
          { rel: 'icon', type: 'image/png', sizes: '32x32', href: '/favicon-32x32.png' },
          { rel: 'icon', type: 'image/png', sizes: '16x16', href: '/favicon-16x16.png' },
          { rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' },
          { rel: 'icon', type: 'image/png', sizes: '192x192', href: '/android-chrome-192x192.png' },
          { rel: 'icon', type: 'image/png', sizes: '512x512', href: '/android-chrome-512x512.png' }
        ]
      }}
    />
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      };

      const setTheme = (theme) => {
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        window.localStorage.setItem('theme', theme);
      };

      // Set initial theme
      setTheme(getTheme());

      // Handle toggle click
      const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.toggle('dark');
        const isDark = element.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };

      // Attach listeners
      const attachListeners = () => {
        document.querySelectorAll('.theme-toggle').forEach((el) => {
          el.removeEventListener('click', handleToggleClick); // Prevent duplicates
          el.addEventListener('click', handleToggleClick);
        });
      };

      // Run on initial load
      // Use standard DOMContentLoaded event
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachListeners);
      } else {
        attachListeners();
      }

      // Run on view transitions
      document.addEventListener('astro:after-swap', () => {
        setTheme(getTheme());
        attachListeners();
      });
    </script>
  </head>
  <body class='min-h-dvh bg-background text-text flex relative isolate'>
    <div
      class='fixed inset-0 -z-10 h-full w-full bg-background bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]'>
      <div
        class='absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary/20 opacity-20 blur-[100px]'>
      </div>
    </div>
    <div class='mx-auto w-full ~max-w-[40rem/96rem] ~px-3/12 py-8 space-y-8 grid grid-rows-[auto_1fr_auto]'>
      <header class='w-full flex md:gap-16 md:justify-center items-center relative'>
        <nav
          class='hidden md:flex justify-center gap-8 rounded-full font-semibold w-min px-8 py-2 shadow-muted/20 dark:shadow-muted/40 shadow-[12px_12px_12px_-12px_-12px_-12px] bg-surface'>
          {
            links.map((link) => (
              <a
                data-astro-prefetch
                title={link.title}
                href={link.href}
                class='relative hover:text-primary transition-colors tracking-wider p-1 outline-primary duration-300 after:content-[""] after:absolute after:left-0 after:bottom-0 after:w-0 after:h-[2px] after:bg-primary after:transition-[width] after:duration-300 hover:after:w-full capitalize'
                class:list={[isCurrent(link.href) ? 'text-primary' : '']}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class='hidden md:block absolute right-0'>
          <ThemeToggle />
        </div>
        <Menu links={links} />
      </header>
      <main class='py-4 ~px-4/64 overflow-auto'><slot /></main>

      <footer class='w-full text-center rounded justify-center text-muted py-4 text-sm'>
        <nav class='space-x-4 [&>a:hover]:text-primary transition-colors'>
          <a href='https://github.com/dpuddinu' target='_blank' rel='noreferrer'>Github</a>
          <a href='https://www.linkedin.com/in/dario-puddinu-2b1056160/' target='_blank' rel='noreferrer'>Linkedin</a>
          <a href='mailto:dpuddinu.dev@gmail.com' rel='noreferrer' title='Send me an email'>Email</a>
        </nav>
      </footer>
    </div>
    <Analytics />
  </body>
</html>
<style is:global>
  @font-face {
    font-family: 'GeistRegular';
    src: url('/fonts/Geist-Regular.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GeistMono';
    src: url('/fonts/GeistMono-Light.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'AfacadFlux';
    src: url('/fonts/AfacadFlux.ttf') format('ttf');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
<style is:global>
  :root {
    --color-primary: 234 88 12;
    --color-secondary: 87 83 78;
    --color-background: 231 229 228;
    --color-text: 28 25 23;
    --color-muted: 120 113 108;
    --color-surface: 250 250 249;
  }
  .dark {
    --color-primary: 249 115 22;
    --color-secondary: 168 162 158;
    --color-background: 24 24 27;
    --color-text: 228 228 231;
    --color-muted: 161 161 170;
    --color-surface: 39 39 42;
  }
  @view-transition {
    navigation: auto; /* enabled! */
  }
  .scroll-bar {
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    /* Track */
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    /* Handle */
    ::-webkit-scrollbar-thumb {
      background: #a8a29e;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-corner {
      background: transparent;
    }

    /* Handle on hover */
    ::-webkit-scrollbar-thumb:hover {
      background: #78716c;
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    /* Hide scrollbar when dialog is open */
    :root:has(dialog[open]) {
      overflow: hidden;
    }
  }
</style>
