---
import { SEO } from 'astro-seo';
import { isCurrentPage } from '@/utils/isCurrentPage';
import Menu from '@components/Menu.astro';
import Analytics from '@vercel/analytics/astro';

type Props = {
  title: string;
  description?: string;
  image?: string;
  type?: string;
};

const {
  title,
  description = 'Senior Frontend Developer with over 5 years of experience, specializing in Angular, React, and NextJS',
  image = '/og-image.png',
  type = 'website'
} = Astro.props;

export type Link = {
  href: string;
  label: string;
  title: string;
};

const links: Link[] = [
  {
    href: '/',
    label: 'Home',
    title: 'Home'
  },
  {
    href: '/about',
    label: 'About',
    title: 'About me'
  },
  {
    href: '/blog',
    label: 'Blog',
    title: 'My blog'
  },
  {
    href: '/til',
    label: 'TIL',
    title: 'Today I Learnt'
  }
];

const isCurrent = (href: string) => isCurrentPage(Astro.url.pathname, href);
---

<html lang='en' class='min-h-dvh scroll-bar'>
  <head>
    <link rel='sitemap' href='/sitemap-index.xml' />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title,
          type,
          image
        }
      }}
      twitter={{
        creator: '@dpdev92'
      }}
      extend={{
        meta: [
          { name: 'viewport', content: 'width=device-width, initial-scale=1.0' },
          { name: 'generator', content: Astro.generator }
        ],
        link: [
          { rel: 'icon', type: 'image/x-icon', href: '/favicon.ico', sizes: 'any' },
          { rel: 'icon', type: 'image/png', sizes: '32x32', href: '/favicon-32x32.png' },
          { rel: 'icon', type: 'image/png', sizes: '16x16', href: '/favicon-16x16.png' },
          { rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' },
          { rel: 'icon', type: 'image/png', sizes: '192x192', href: '/android-chrome-192x192.png' },
          { rel: 'icon', type: 'image/png', sizes: '512x512', href: '/android-chrome-512x512.png' }
        ]
      }}
    />
  </head>
  <body class='min-h-dvh bg-zinc-900/95 text-zinc-200 flex'>
    <div class='mx-auto w-full ~max-w-[40rem/96rem] ~px-3/12 py-8 space-y-8 grid grid-rows-[auto_1fr_auto]'>
      <header class='w-full flex md:gap-16 md:justify-center items-center relative'>
        <nav
          class='hidden md:flex justify-center gap-8 rounded-full font-semibold w-min px-8 py-2 shadow-zinc-200/20 shadow-[12px_12px_12px_-12px_-12px_-12px]'>
          {
            links.map((link) => (
              <a
                data-astro-prefetch
                title={link.title}
                href={link.href}
                class='hover:text-primary transition-colors tracking-wider p-1 outline-primary duration-300 border-b border-b-transparent hover:border-b-primary capitalize'
                class:list={[isCurrent(link.href) ? 'text-primary' : '']}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <Menu links={links} />
      </header>
      <main class='py-4 ~px-4/64 overflow-auto'><slot /></main>

      <footer class='w-full text-center rounded justify-center text-zinc-200/70 py-4 text-sm'>
        <nav class='space-x-4 [&>a:hover]:text-blue-400 transition-colors'>
          <a href='https://github.com/dpuddinu' target='_blank' rel='noreferrer'>Github</a>
          <a href='https://www.linkedin.com/in/dario-puddinu-2b1056160/' target='_blank' rel='noreferrer'>Linkedin</a>
          <a href='mailto:dpuddinu.dev@gmail.com' rel='noreferrer' title='Send me an email'>Email me</a>
        </nav>
      </footer>
    </div>
    <Analytics />
  </body>
</html>
<style is:global>
  @font-face {
    font-family: 'GeistRegular';
    src: url('/fonts/Geist-Regular.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GeistMono';
    src: url('/fonts/GeistMono-Light.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'AfacadFlux';
    src: url('/fonts/AfacadFlux.ttf') format('ttf');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
<style is:global>
  @view-transition {
    navigation: auto; /* enabled! */
  }
  .scroll-bar {
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    /* Track */
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    /* Handle */
    ::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-corner {
      background: transparent;
    }

    /* Handle on hover */
    ::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    /* Hide scrollbar when dialog is open */
    :root:has(dialog[open]) {
      overflow: hidden;
    }
  }
</style>
