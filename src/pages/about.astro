---
import MainLayout from '../layouts/MainLayout.astro';
import Skills from '@components/icons/Skills.astro';
---

<MainLayout title='About'>
  <div class='text-neutral-300 font-afacad'>
    <h1 class='~text-4xl/6xl font-bold'>So, who am I?</h1>
    <section class='grid md:grid-cols-[1fr_auto] gap-8'>
      <article>
        <p class='~pt-4/8 ~text-xl/2xl'>
          Hi! I'm Dario, a 32-year-old frontend developer originally from Sardinia, Italy.
        </p>
        <br />
        <p>
          My programming journey began in 2013 when I enrolled in Electronic Engineering and Computer Science at the
          University of Pavia.
        </p>
        <p class='pt-2'>Starting with C and Assembly, I later expanded my expertise to Java and JavaScript.</p>
        <p class='pt-2'>
          Throughout my academic journey, I mastered essential software development concepts that I apply daily in my
          work, including SOLID Principles, Design Patterns, and Test-Driven Development.
        </p>
        <p class='pt-2'>
          My professional path has led me to work as a consultant for several notable companies, including:
          <ul class='list-disc list-inside [&>li]:underline [&>li]:text-lg'>
            <li>
              <a href='https://www.alkemy.com/' target='_blank'>Alkemy</a>
            </li>
            <li>
              <a href='https://www.repower.com/' target='_blank'>RePower</a>
            </li>
            <li>
              <a href='https://www.abissi.eu/' target='_blank'>Abissi</a>
            </li>
            <li>
              <a href='https://www.abinsula.com/' target='_blank'>Abinsula</a>
            </li>
            <li>
              <a href='https://www.degustiamo.com/' target='_blank'>Degustiamo</a>
            </li>
            <li>
              <a href='https://www.energyteam.it/' target='_blank'>EnergyTeam</a>
            </li>
          </ul>
        </p>
      </article>
      <article>
        <h3 class='~text-2xl/4xl font-mono font-semibold tracking-wide flex gap-4 items-end'><Skills /> Skills</h3>
        <ul class='space-y-2 pt-4 text-neutral-300 text-lg'>
          <li class='grid grid-cols-2'>
            <span>Angular</span>
            <span class='text-yellow-400'>★★★★☆</span>
          </li>
          <li class='grid grid-cols-2'>
            <span>React</span>
            <span class='text-yellow-400'>★★★★★</span>
          </li>
          <li class='grid grid-cols-2'>
            <span>Next.js</span>
            <span class='text-yellow-400'>★★★★★</span>
          </li>
          <li class='grid grid-cols-2'>
            <span>JavaScript</span>
            <span class='text-yellow-400'>★★★★★</span>
          </li>
          <li class='grid grid-cols-2'>
            <span>TypeScript</span>
            <span class='text-yellow-400'>★★★★☆</span>
          </li>
          <li class='grid grid-cols-2'>
            <span>HTML & CSS</span>
            <span class='text-yellow-400'>★★★★★</span>
          </li>
        </ul>
      </article>
    </section>
  </div>
</MainLayout>
