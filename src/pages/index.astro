---
import Download from '@components/icons/Download.astro';
import Work from '@components/icons/Work.astro';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const blogPosts = await getCollection('blog');
---

<MainLayout title='Portfolio'>
  <div class='grid md:grid-cols-[1fr,auto] gap-24'>
    <section>
      <article class='flex flex-col gap-4'>
        <h1 class='~text-4xl/6xl font-bold font-mono max-w-[10em]'>Dario Puddinu</h1>
        <h2 class='~text-2xl/4xl font-bold font-mono text-zinc-200/20'>Senior Frontend Developer</h2>
        <div class='max-w-[40em] text-lg flex flex-col gap-1 text-neutral-300 text-balance py-4'>
          <p>Hello, I'm Dario, a frontend developer with over 5 years of experience based in Sassari.</p>
          <p>I love creating performant web app using Angular, React, and NextJs.</p>
          <p></p>
          <small class='italic leading-5 pt-2'>
            (although this portfolio is built with Astro because is super cool and fast)
          </small>
        </div>

        <div class='my-8'>
          <ul>
            {
              blogPosts.map((entry) => (
                <li class='grid sm:grid-cols-[auto,1fr] gap-2 sm:gap-4'>
                  <div class='place-content-center sm:h-10'>
                    <time
                      datetime={entry.data.publishDate.toISOString()}
                      class='font-semibold border-l border-slate-600/80 pl-2 text-slate-400'>
                      {entry.data.publishDate.toLocaleDateString('en-US', {
                        month: 'long',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </time>
                  </div>
                  <div>
                    <p class='text-2xl place-content-center font-semibold sm:min-h-10'>{entry.data.title}</p>
                    <p class=''>{entry.data.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </section>
    <section class='flex flex-col gap-8'>
      <section class='sm:max-w-sm pt-4'>
        <article>
          <h3 class='~text-2xl/4xl font-mono font-semibold tracking-wide flex gap-4 items-end'><Work /> Work</h3>
          <ul class='space-y-2 pt-4'>
            <li class='grid grid-cols-2'>
              <div>
                <a href='https://abinsula.com' target='_blank' rel='noreferrer'>Abinsula</a><p class='text-zinc-200/20'>
                  Frontend Developer
                </p>
              </div>
              <small class='text-end font-mono'>2022 - current</small>
            </li>
            <li class='grid grid-cols-2'>
              <div>
                <a href='https://www.energyteam.it/' target='_blank' rel='noreferrer'>Energy Team</a><p
                  class='text-zinc-200/20'>
                  Fullstack Developer
                </p>
              </div>
              <small class='text-end font-mono'>2019 - 2022</small>
            </li>
          </ul>
          <div class='flex justify-end pt-8'>
            <div
              class='rounded rounded-l-lg hover:bg-zinc-200/20 flex shadow w-fit shadow-zinc-300/20 sm:max-w-xs h-8 text-sm transition-all active:scale-95 duration-300'>
              <a href='favicon.svg' class='shadow px-4 text-lg place-content-center' download>Download CV</a>
              <a
                class='px-2 shadow bg-zinc-300 cursor-pointer rounded-r-lg place-content-center'
                download
                aria-label='Download'>
                <Download />
              </a>
            </div>
          </div>
        </article>
      </section>
    </section>
  </div>
</MainLayout>
