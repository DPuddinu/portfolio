---
import Download from '@components/icons/Download.astro';
import Work from '@components/icons/Work.astro';
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { formatDate } from '@/utils/formatDate';

const allBlogPosts = await getCollection('blog');
const lastBlogPosts = allBlogPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
const viewMore = allBlogPosts.length > lastBlogPosts.length;
---

<MainLayout
  title='Dario Puddinu portfolio'
  description='This is the homepage of Dario Puddinu portfolio, Dario Puddinu is a frontend developer based in Sassari with over 5 years of experience, you can find here the latest blog posts and the work experience'>
  <div class='grid md:grid-cols-[1fr,auto] ~gap-4/24'>
    <section>
      <article class='flex flex-col gap-4'>
        <h1 class='~text-4xl/6xl font-bold font-mono' transition:name='h1'>Dario Puddinu</h1>
        <h2 class='~text-2xl/4xl w-fit font-bold font-mono text-zinc-200/70 motion-preset-fade'>
          Senior Frontend Developer
        </h2>
        <div class='text-lg flex flex-col gap-1 text-neutral-300 py-4 text-balance'>
          <p>Hello, I'm Dario, a frontend developer with over 5 years of experience based in Sassari.</p>
          <p class='text-pretty'>I love creating performant web apps using Angular, React, and NextJs.</p>
          <p></p>
          <small class='italic leading-5 pt-2'>
            (although this portfolio is built with Astro because is super cool and fast)
          </small>
        </div>

        <div class='my-8'>
          <ul class='space-y-4'>
            {
              lastBlogPosts.map((entry) => (
                <li class='grid sm:grid-cols-[auto,1fr] gap-2 sm:gap-4'>
                  <div class='place-content-center sm:h-10'>
                    <time
                      datetime={entry.data.publishDate.toISOString()}
                      class='font-semibold border-l border-slate-600/80 pl-2 text-slate-400'>
                      {formatDate(entry.data.publishDate)}
                    </time>
                  </div>
                  <div>
                    <a
                      href={`/blog/${entry.data.slug}`}
                      class='text-2xl place-content-center transition-colors hover:text-blue-100 text-blue-300 font-semibold sm:min-h-10'>
                      {entry.data.title}
                    </a>
                    <p class=''>{entry.data.description}</p>
                  </div>
                </li>
              ))
            }
            {
              viewMore && (
                <li>
                  <a href='/blog' class='italic text-slate-400 hover:text-slate-300 transition-colors'>
                    View more...
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </article>
    </section>
    <section class='flex flex-col gap-8'>
      <section class='sm:max-w-sm pt-4 space-y-8'>
        <article>
          <h3 class='~text-2xl/4xl font-mono font-semibold tracking-wide flex gap-4 items-end'><Work /> Work</h3>
          <ul class='space-y-2 pt-4'>
            <li class='grid grid-cols-2'>
              <div>
                <a href='https://bizaway.com' target='_blank' rel='noreferrer'>BizAway</a><p class='text-zinc-200/70'>
                  Frontend Developer
                </p>
              </div>
              <small class='text-end font-mono'>2025 - current</small>
            </li>
            <li class='grid grid-cols-2'>
              <div>
                <a href='https://abinsula.com' target='_blank' rel='noreferrer'>Abinsula</a><p class='text-zinc-200/70'>
                  Frontend Developer
                </p>
              </div>
              <small class='text-end font-mono'>2022 - 2025</small>
            </li>
            <li class='grid grid-cols-2'>
              <div>
                <a href='https://www.energyteam.it/' target='_blank' rel='noreferrer'>Energy Team</a><p
                  class='text-zinc-200/70'>
                  Fullstack Developer
                </p>
              </div>
              <small class='text-end font-mono'>2019 - 2022</small>
            </li>
          </ul>
        </article>

        <div class='pb-8'>
          <div class='w-full group h-10 flex sm:max-w-xs text-sm active:scale-95'>
            <a
              href='/cv.pdf'
              class='px-4 grow text-lg place-content-center hover:bg-zinc-200/30 bg-zinc-200/20 rounded-l-lg transition-all'
              aria-label='Download CV'
              download>
              Download CV
            </a>
            <a
              href='/cv.pdf'
              class='px-4 bg-zinc-300 cursor-pointer rounded-r-lg place-content-center'
              aria-label='Download CV'
              download>
              <Download />
            </a>
          </div>
        </div>
      </section>
    </section>
  </div>
</MainLayout>
