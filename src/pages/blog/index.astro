---
import { formatDate } from '@/utils/formatDate';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
---

<MainLayout title='Blog'>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {
      allBlogPosts.map((entry) => (
        <a href={`/blog/${entry.id}`} class='relative block overflow-hidden rounded-lg border border-neutral-700 shadow-sm shadow-neutral-700/20 ~p-4/8 '>
          <span class='absolute inset-x-0 bottom-0 h-2 bg-gradient-to-r from-green-300 via-blue-500 to-purple-600' />
  
          <div class='space-y-4'>
            <h2 class='font-bold ~text-4xl/3xl'>{entry.data.title}</h2>
            <p class=' text-gray-500'>{entry.data.description}</p>
          </div>
  
          <dl class='mt-6 flex gap-4 sm:gap-6'>
            <dl class='flex flex-col-reverse'>
              <dd class='text-xs text-gray-500'>{formatDate(entry.data.publishDate)}</dd>
            </dl>
          </dl>
        </a>
      ))
    }
  </div>
</MainLayout>
