---
import BlogCard from '@components/BlogCard.astro';
import BlogFilters from '@components/BlogFilters.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
const allBlogPosts = await getCollection('blog');
const years = Array.from(new Set(allBlogPosts.map((post) => post.data.publishDate.getFullYear())));
---

<MainLayout
  title='Blog | Dario Puddinu'
  description='Articles about frontend development, React, Angular, and web technologies written by Dario Puddinu'
  type='blog'>
  <div class='pb-4 space-y-4'>
    <h1 class='~text-4xl/6xl font-bold font-mono' transition:name='h1'>Blog</h1>
    <BlogFilters years={years} />
  </div>
  <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-4'>
    {allBlogPosts.map((entry) => <BlogCard entry={entry} />)}
  </div>
</MainLayout>
