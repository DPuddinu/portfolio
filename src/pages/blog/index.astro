---
import { formatDate } from '@/utils/formatDate';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
---

<MainLayout
  title='Blog | Dario Puddinu'
  description='Articles about frontend development, React, Angular, and web technologies'
  type='blog'>
  <div class='grid sm:grid-cols-2 md:grid-cols-3 gap-4'>
    {
      allBlogPosts.map((entry) => (
        <a
          href={`/blog/${entry.id}`}
          class='relative hover:bg-zinc-700 block shadow transition-all shadow-zinc-700/20 hover:shadow-zinc-700/50 overflow-hidden rounded-lg border border-neutral-700 ~p-4/8 '>
          <span class='absolute inset-x-0 bottom-0 h-2 bg-gradient-to-r from-green-300 via-blue-500 to-purple-600' />

          <div class='space-y-4'>
            <h2 class='font-bold ~text-xl/3xl'>{entry.data.title}</h2>
            <p class='~text-base/lg text-zinc-200/70'>{entry.data.description}</p>
          </div>

          <dl class='mt-6 flex gap-4 sm:gap-6'>
            <dl class='flex flex-col-reverse'>
              <dd class='~text-xs/sm text-zinc-200/70'>{formatDate(entry.data.publishDate)}</dd>
            </dl>
          </dl>
        </a>
      ))
    }
  </div>
</MainLayout>
